{
  "expo": {
    "name": "Treadmill Urbis",
    "slug": "treadmill-urbis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.borjaurbis.treadmillurbis",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#C6FF3D",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Treadmill Urbis usa el micrófono para que dictes tus sesiones.",
          "speechRecognitionPermission": "Treadmill Urbis usa el reconocimiento de voz para entender tus sesiones.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Treadmill Urbis usa la cámara para leer la pantalla de la cinta.",
          "photosPermission": "Treadmill Urbis abre tus fotos para leer los datos de la cinta."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Treadmill",
              "label": "Treadmill Urbis",
              "description": "Km de hoy y de la semana, y botones para añadir una sesión",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "scheme": "treadmillurbis",
    "backgroundColor": "#07090D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090D"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}