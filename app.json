{
  "expo": {
    "name": "Treadmill Urbis",
    "slug": "treadmill-urbis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.borjaurbis.treadmillurbis",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07090D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#C6FF3D",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Treadmill Urbis usa el micrófono para que dictes tus sesiones.",
          "speechRecognitionPermission": "Treadmill Urbis usa el reconocimiento de voz para entender tus sesiones.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "scheme": "treadmillurbis",
    "backgroundColor": "#07090D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090D"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}